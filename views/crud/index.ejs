<%- include("../partials/header") %>
<div class="container my-5">
    <h1 class="mb-3">Notebookok kezelése (CRUD)</h1>
    <a class="btn btn-success mb-3" href="/crud/new">Új notebookot hozzáad</a>
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm align-middle">
            <thead class="table-primary">
                <tr><th>ID</th><th>Gyártó</th><th>Típus</th><th>Kijelző</th><th>Memória</th><th>Merevlemez</th><th>Ár</th><th>Raktáron</th><th>Műveletek</th></tr>
            </thead>
            <tbody>
                <% if (gepek.length === 0) { %>
                <tr><td colspan="9">Nincs notebook az adatbázisban.</td></tr>
                <% } else { %>
                <% gepek.forEach((g, i) => { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= g.gyarto %></td>
                    <td><%= g.tipus %></td>
                    <td><%= g.kijelzo %>"</td>
                    <td><%= g.memoria %> MB</td>
                    <td><%= g.merevlemez %> GB</td>
                    <td class="text-nowrap"><%= g.ar.toLocaleString("hu-HU") %> Ft</td>
                    <td><%= g.db %></td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-primary" href="/crud/edit/<%= g._id %>">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/crud/delete/<%= g._id %>" onclick="return confirm('Biztosan törli?')">Delete</a>
                    </td>
                </tr>
                <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<%- include("../partials/footer") %>
