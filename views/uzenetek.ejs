<%- include("partials/header") %>
<div class="container my-5">
    <h1 class="mb-2">Üzenetek</h1>
    <p class="lead">A Kapcsolat űrlapon küldött üzenetek, a legfrissebb elől.</p>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-primary">
                <tr><th>Küldés ideje</th><th>Név</th><th>E-mail</th><th>Tárgy</th><th>Üzenet</th></tr>
            </thead>
            <tbody>
                <% if (uzenetek.length === 0) { %>
                <tr><td colspan="5">Még nem érkezett üzenet.</td></tr>
                <% } else { %>
                <% uzenetek.forEach(u => { %>
                <tr>
                    <td class="text-nowrap"><%= u.datum.toLocaleString("hu-HU", { timeZone: "Europe/Budapest" }) %></td>
                    <td><%= u.nev %></td>
                    <td><%= u.email %></td>
                    <td><%= u.targy %></td>
                    <td><%= u.uzenet %></td>
                </tr>
                <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
<%- include("partials/footer") %>
